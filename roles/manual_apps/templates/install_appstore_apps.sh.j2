#!/bin/bash
# App Store Apps Quick Installer
# Generated by Ansible - opens all App Store apps for manual installation

echo "🍎 Opening App Store applications for installation..."
echo "Please complete the installation for each app that opens."
echo ""

{% for app in appstore_manual_apps %}
echo "Opening {{ app.name }}..."
open "macappstore://itunes.apple.com/app/id{{ app.id }}"
sleep 2
{% endfor %}

echo ""
echo "✅ All App Store apps opened!"
echo "📱 Please complete the installation in the App Store."
echo ""
echo "After installation, verify with:"
echo "ls /Applications/ | grep -E '({{ appstore_manual_apps | map(attribute='name') | join('|') }})'"